# Copy this file to .env (which Git ignores) and fill in the values.
# Never commit .env or paste these values into chat.

# Supabase > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The receiver device key returned once by:  select create_gateway('<installation id>');
DEVICE_KEY=

# Must match SYSTEM_ID in the firmware and installations.lora_system_id
LORA_SYSTEM_ID=123456
